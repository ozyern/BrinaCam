<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#14F28C38" />
            <size android:width="84dp" android:height="84dp" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#1A1A1A" />
            <stroke android:width="3dp" android:color="#4D4D4D" />
        </shape>
    </item>
    <item android:top="9dp" android:left="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="oval">
            <gradient android:startColor="@color/oc_accent_light" android:endColor="@color/oc_accent_dark" android:angle="270" />
        </shape>
    </item>
</layer-list>
